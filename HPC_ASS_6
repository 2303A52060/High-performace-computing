        "outputId": "8c131c78-27ca-43d9-c5fb-982b9e61fdb8"
      },
      "source": [
        "# Define a range of array sizes to test (in bytes)\n",
        "# Start from small sizes to hit cache, go up to main memory sizes\n",
        "min_exponent = 10 # 2^10 bytes = 1 KB\n",
        "max_exponent = 28 # 2^28 bytes = 256 MB (approx)\n",
        "num_steps = 20\n",
        "\n",
        "array_sizes = np.logspace(min_exponent, max_exponent, num_steps, base=2, dtype=int)\n",
        "\n",
        "# Store results\n",
        "bandwidths = []\n",
        "times = []\n",
        "actual_array_sizes = []\n",
        "\n",
        "print(\"Starting bandwidth measurement...\")\n",
        "for size_bytes in array_sizes:\n",
        "    # Ensure array_size_bytes is a multiple of 8 for float64 elements\n",
        "    aligned_size_bytes = (size_bytes // 8) * 8\n",
        "    if aligned_size_bytes == 0:\n",
        "        continue\n",
        "\n",
        "    print(f\"Testing array size: {aligned_size_bytes / (1024**2):.2f} MB...\")\n",
        "    bw, et = measure_bandwidth(aligned_size_bytes)\n",
        "    bandwidths.append(bw)\n",
        "    times.append(et)\n",
        "    actual_array_sizes.append(aligned_size_bytes)\n",
        "    print(f\"  Bandwidth: {bw:.2f} GB/s, Time: {et:.4f} s\")\n",
        "\n",
        "print(\"Measurement complete. Plotting results...\")\n",
        "\n",
        "# Plotting the results\n",
        "plt.figure(figsize=(12, 6))\n",
        "plt.plot(np.array(actual_array_sizes) / (1024**2), bandwidths, marker='o', linestyle='-')\n",
        "plt.xscale('log')\n",
        "plt.xlabel('Array Size (MB, log scale)')\n",
        "plt.ylabel('Memory Bandwidth (GB/s)')\n",
        "plt.title('Memory Bandwidth vs. Array Size on Single NUMA Node')\n",
        "plt.grid(True, which=\"both\", ls=\"--\", alpha=0.7)\n",
        "\n",
        "# Corrected line: Convert the list slice to a NumPy array before division\n",
        "x_ticks_values = np.array(actual_array_sizes[::(len(actual_array_sizes)//5)+1]) / (1024**2)\n",
        "x_ticks_labels = [f'{s/(1024**2):.0f}MB' for s in actual_array_sizes[::(len(actual_array_sizes)//5)+1]]\n",
        "plt.xticks(x_ticks_values, x_ticks_labels, rotation=45, ha='right')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
